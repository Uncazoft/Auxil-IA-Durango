rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Los usuarios solo pueden leer y escribir sus propios chats.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;

      // Los usuarios solo pueden leer y escribir sus propios mensajes.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.userId;
      }
    }
  }
}